aws_region   = "ap-northeast-1"
# please xxxx use whatever you want
project_name = "moojidle-xxxx"

# Create this EC2 key pair in AWS first, or reuse an existing one.
key_name = "your-ec2-keypair-name"

# Optional: use existing network resources. If omitted, Terraform uses the default VPC and its subnets.
# vpc_id     = "vpc-xxxxxxxxxxxxxxxxx"
# subnet_ids = ["subnet-xxxxxxxxxxxxxxxxx", "subnet-yyyyyyyyyyyyyyyyy"]

ssh_cidr_blocks            = ["0.0.0.0/0"]
kubernetes_api_cidr_blocks = ["0.0.0.0/0"]
app_cidr_blocks            = ["0.0.0.0/0"]

domain_name          = "app.example.com"
cloudflare_zone_id   = "your-cloudflare-zone-id"
cloudflare_api_token = "your-cloudflare-api-token"

control_plane_count         = 3
worker_count                = 2
control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.small"
root_volume_size            = 30

# CloudWatch Alarms Configuration
alarm_email                 = "your-email@example.com"
cpu_alarm_threshold         = 70                    # In percentage
cp_network_in_threshold     = 1000000000            # In Bytes
worker_network_in_threshold = 625000000             # In Bytes

# MongoDB Atlas — create a Programmatic API Key in Atlas (Project Access Manager) first.
mongodbatlas_public_key  = "your-public-key"
mongodbatlas_private_key = "your-private-key"
mongodbatlas_project_id  = "your-project-id"
